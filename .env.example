# Public origin of the deployed site, without a trailing slash.
# Required for production builds: it drives canonical URLs, the sitemap,
# robots.txt, Open Graph URLs and JSON-LD. The production domain has not been
# chosen yet, so there is deliberately no default.
#
# Example: NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Contact details and résumé (all optional, all public).
# These override the values in src/data/profile.ts. Invalid values are
# dropped with a build warning and never shown. At least one of email,
# LinkedIn or GitHub is required before deploying (npm run check:deploy).
#
# NEXT_PUBLIC_CONTACT_EMAIL=name@example.com
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-profile
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-account
# A PDF placed in public/ (e.g. /resume.pdf) or an https URL to a PDF.
# NEXT_PUBLIC_RESUME_URL=/resume.pdf
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_RESUME_URL=
